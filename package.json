{
  "name": "dsh-plugin-devlog-poster",
  "version": "0.7.0",
  "description": "DSH (DeepSeek Harness) Build-in-Public devlog & daily/weekly work report plugin for GitHub, Xiaohongshu, Bilibili, Douyin, Feishu, DingTalk, WeCom, Slack, Discord, and QQ.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "devlog-poster": "./src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kirakila7/dsh-plugin-devlog-poster.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "assets",
    "skills",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "generate": "node src/cli.js generate"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "devlog",
    "build-in-public",
    "xiaohongshu",
    "bilibili",
    "douyin",
    "github"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
